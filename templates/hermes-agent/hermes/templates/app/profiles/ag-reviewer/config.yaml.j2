# {{ ansible_managed }}

model:
  provider: opencode-go
  default: gemini-4-argon

dashboard:
  show_token_analytics: true

agent:
  max_turns: 150
  reasoning_effort: medium

approvals:
  mode: {{ hermes_approvals_mode }}
  cron_mode: {{ hermes_approvals_cron_mode }}
  unattended_mode: {{ hermes_approvals_unattended_mode }}

terminal:
  home_mode: profile
  cwd: /opt/data/profiles/ag-reviewer/workspace

timezone: {{ hermes_timezone }}
