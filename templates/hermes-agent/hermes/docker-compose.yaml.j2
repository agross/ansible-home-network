services:
  app:
    image: {{ hermes_image }}
    command: gateway run
    restart: unless-stopped
    depends_on:
      hindsight:
        condition: service_healthy
    {% if hermes_browser_tools_enabled %}
    shm_size: {{ hermes_shm_size }}
    {% endif %}
    environment:
      PUID: {{ hermes_uid }}
      PGID: {{ hermes_gid }}
      # Abort startup if provider installation fails in the s6 init hook.
      S6_BEHAVIOUR_IF_STAGE2_FAIL: "2"

      {% if hermes_dashboard_enabled %}
      HERMES_DASHBOARD: true
      HERMES_DASHBOARD_HOST: 0.0.0.0
      HERMES_DASHBOARD_PORT: 9119
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: {{ hermes_dashboard_basic_auth_username }}
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: {{ hermes_dashboard_basic_auth_password }}
      HERMES_DASHBOARD_BASIC_AUTH_SECRET: >-
        {{
          hermes_dashboard_basic_auth_password |
          password_hash('bcrypt',
                        ('./abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890' |
                          shuffle(seed = inventory_hostname) |
                          join)[:21]
                        +
                        ('.Oeu' |
                          shuffle(seed = inventory_hostname) |
                          join)[1]
                      ) |
          ansible.builtin.b64encode
        }}
      {% endif %}
    volumes:
      - ./app:/opt/data
      - ./hindsight/install-plugins.sh:/etc/cont-init.d/03-hindsight-plugins:ro
      - /var/run/docker.sock:/var/run/docker.sock:z
    {% if hermes_dashboard_enabled or hermes_api_server_enabled or hermes_webhooks_enabled %}
    healthcheck:
      test:
        - CMD
        - curl
        - --fail-with-body
        {% if hermes_dashboard_enabled %}
        # Web dashboard.
        - http://localhost:9119/api/status
        {% endif %}
        {% if hermes_api_server_enabled %}
        # OpenAI-compatible API server.
        - http://localhost:8642/health
        {% endif %}
        {% if hermes_webhooks_enabled %}
        # Webhooks.
        - http://localhost:8644/health
        {% endif %}
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 2s
    ports:
      {% if hermes_dashboard_enabled %}
      # Web dashboard.
      - {{ hermes_dashboard_port }}:9119
      {% endif %}
      {% if hermes_api_server_enabled %}
      # OpenAI-compatible API server.
      - {{ hermes_api_server_port }}:8642
      {% endif %}
      {% if hermes_webhooks_enabled %}
      # Webhooks.
      - {{ hermes_webhooks_port }}:8644
      {% endif %}
    {% endif %}

  hindsight:
    image: ghcr.io/vectorize-io/hindsight:1.0.0
    restart: unless-stopped
    user: "{{ hermes_uid }}:{{ hermes_gid }}"
    depends_on:
      ollama-model:
        condition: service_completed_successfully
    environment:
      HINDSIGHT_ENABLE_CP: "false"
      HINDSIGHT_API_LLM_PROVIDER: ollama
      HINDSIGHT_API_LLM_BASE_URL: http://ollama:11434/v1
      HINDSIGHT_API_LLM_MODEL: {{ hermes_hindsight_llm_model | ansible.builtin.to_json }}
      HINDSIGHT_API_LLM_OLLAMA_NUM_CTX: {{ hermes_hindsight_llm_context }}
      HINDSIGHT_API_LLM_TIMEOUT: {{ hermes_hindsight_llm_timeout }}
      HINDSIGHT_API_REFLECT_LLM_TIMEOUT: {{ hermes_hindsight_llm_timeout }}
      # Avoid concurrent CPU inference competing across profiles.
      HINDSIGHT_API_LLM_MAX_CONCURRENT: 1
      HINDSIGHT_API_EMBEDDINGS_PROVIDER: local
      HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL: {{ hermes_hindsight_embedding_model | ansible.builtin.to_json }}
      HINDSIGHT_API_RERANKER_PROVIDER: local
      HINDSIGHT_API_RERANKER_LOCAL_MODEL: {{ hermes_hindsight_reranker_model | ansible.builtin.to_json }}
      HINDSIGHT_API_TEXT_SEARCH_EXTENSION_NATIVE_LANGUAGE: german
      HF_HOME: /home/hindsight/.cache/huggingface
    volumes:
      - ./hindsight/data:/home/hindsight/.pg0
      - ./hindsight/cache:/home/hindsight/.cache
    healthcheck:
      test: [CMD, curl, --fail-with-body, http://localhost:8888/health]
      interval: 30s
      timeout: 5s
      retries: 3
      # Multilingual models are downloaded on the first start.
      start_period: 10m
      start_interval: 5s

  ollama:
    image: ollama/ollama:0.40.4
    restart: unless-stopped
    environment:
      OLLAMA_NO_CLOUD: "1"
    volumes:
      - ./ollama:/root/.ollama
    healthcheck:
      test: [CMD, ollama, list]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s

  # Fetch the configured model before Hindsight starts; cached pulls are incremental.
  ollama-model:
    image: ollama/ollama:0.40.4
    command: [pull, {{ hermes_hindsight_llm_model | ansible.builtin.to_json }}]
    environment:
      OLLAMA_HOST: http://ollama:11434
    depends_on:
      ollama:
        condition: service_healthy

  immich-mcp:
    image: ghcr.io/joeru/claw2immich:sha-a39ae71
    environment:
      IMMICH_BASE_URL: https://{{ immich_domain | ansible.builtin.mandatory }}
      # Required because /api/server-config no longer exists.
      IMMICH_EXTERNAL_DOMAIN: https://{{ immich_domain | ansible.builtin.mandatory }}
      IMMICH_API_KEY: {{ hermes_profile.the_dude.immich.api_key }}
      IMMICH_PROFILE: read_only

      MCP_TRANSPORT: streamable-http
      MCP_HOST: 0.0.0.0
      # MCP_LOG_LEVEL: DEBUG

  kodi-tracker:
    image: nousresearch/hermes-agent:v0.21.5
    entrypoint: [python3, -u]
    command: /opt/data/profiles/the-dude/skills/personal/kodi-music-summary/scripts/stream.py
    user: "{{ hermes_uid }}:{{ hermes_gid }}"
    restart: unless-stopped
    environment:
      HERMES_HOME: /opt/data/profiles/the-dude
      TZ: {{ hermes_timezone }}
      KODI_HOST: {{ hermes_profile.the_dude.kodi.host }}
      KODI_PORT: {{ hermes_profile.the_dude.kodi.port }}
      KODI_USER: {{ hermes_profile.the_dude.kodi.username }}
      KODI_PASS: {{ hermes_profile.the_dude.kodi.password }}
    volumes:
      - ./app:/opt/data

  kodi-mcp:
    image: kodi-mcp:local
    build:
      context: https://github.com/laHeud/kodi-mcp-server.git#8b42eace32f5a6b04982fdee0ff96596ba6580b2
    environment:
      KODI_HOST: {{ hermes_profile.the_dude.kodi.host }}
      KODI_PORT: {{ hermes_profile.the_dude.kodi.port }}
      KODI_USERNAME: {{ hermes_profile.the_dude.kodi.username }}
      KODI_PASSWORD: {{ hermes_profile.the_dude.kodi.password }}

      MCP_SERVER_NAME: kodi-controller

      LOG_LEVEL: INFO
      LOG_FORMAT: json

      ENVIRONMENT: production

  # Needs manual setup:
  # anytype auth apikey create mcp
  #
  # The key needs to be added to the OPENAPI_MCP_HEADERS for anytype-mcp
  # via the .env file: ANYTYPE_CLI_TOKEN.
  anytype-cli:
    image: anyproto/anytype-cli:v0.5.0
    command:
      - serve
      - --listen-address
      - 0.0.0.0:31012
    environment:
      ANYTYPE_API_ALLOWED_HOSTS: anytype-cli
    volumes:
      - ./anytype/home:/root/.anytype
      - ./anytype/config:/root/.config/anytype

  nextcloud-gw-mcp:
    image: ghcr.io/cbcoutinho/nextcloud-mcp-server:0.199.4
    environment:
      NEXTCLOUD_HOST: {{ hermes_profile.the_dude.nextcloud.gw.host }}
      NEXTCLOUD_USERNAME: {{ hermes_profile.the_dude.nextcloud.gw.username }}
      NEXTCLOUD_PASSWORD: {{ hermes_profile.the_dude.nextcloud.gw.password }}

  nextcloud-trs-mcp:
    image: ghcr.io/cbcoutinho/nextcloud-mcp-server:0.199.4
    environment:
      NEXTCLOUD_HOST: {{ hermes_profile.the_dude.nextcloud.trs.host }}
      NEXTCLOUD_USERNAME: {{ hermes_profile.the_dude.nextcloud.trs.username }}
      NEXTCLOUD_PASSWORD: {{ hermes_profile.the_dude.nextcloud.trs.password }}
