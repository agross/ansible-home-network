services:
  db:
    image: postgres:18.6-alpine
    environment:
      POSTGRES_USER: finance
      POSTGRES_PASSWORD: {{ banking_finance_password }}
      POSTGRES_DB: finance
      TZ: Europe/Berlin

      # For psql invocations.
      PGUSER: finance
      PGPASSWORD: {{ banking_finance_password }}
      PGDATABASE: finance
    volumes:
      - ./db:/var/lib/postgresql
      - ./postgres-init:/docker-entrypoint-initdb.d:ro
    ports:
      - 5433:5432
    healthcheck:
      test:
        - CMD
        - psql
        - --command=select 1
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 15s
      start_interval: 2s

  app:
    image: cr.grossweber.com/gw/aqbanking-sql:177
    command: sync
    environment:
      FINANCE_POSTGRESQL_CONNECTION_STRING: >-
        Host=db;Database=finance;Username=finance;Password={{ banking_finance_password }}
    volumes:
      - ./app:/finance
    profiles:
      - update
    depends_on:
      db:
        condition: service_healthy
