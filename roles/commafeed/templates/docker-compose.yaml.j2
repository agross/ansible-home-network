services:
  db:
    image: postgres:18.4-alpine
    environment:
      POSTGRES_USER: commafeed
      POSTGRES_PASSWORD: commafeed
      POSTGRES_DB: commafeed
      TZ: Europe/Berlin

      # For psql invocations.
      PGUSER: commafeed
      PGPASSWORD: commafeed
      PGDATABASE: commafeed
    volumes:
      - ./db:/var/lib/postgresql
    healthcheck:
      test:
        - CMD
        - psql
        - --command=select 1
      interval: 5s
      timeout: 5s
      retries: 3

  app:
    image: athou/commafeed:7.2.0-postgresql
    environment:
      QUARKUS_DATASOURCE_JDBC_URL: jdbc:postgresql://db/commafeed
      QUARKUS_DATASOURCE_USERNAME: commafeed
      QUARKUS_DATASOURCE_PASSWORD: commafeed

      COMMAFEED_USERS_CREATE_DEMO_ACCOUNT: false
      COMMAFEED_USERS_ALLOW_REGISTRATIONS: false
      COMMAFEED_DATABASE_CLEANUP_MAX_FEED_CAPACITY: 1500
    ports:
      - 4000:8082
    depends_on:
      db:
        condition: service_healthy
