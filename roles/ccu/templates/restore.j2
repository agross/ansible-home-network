#!/usr/bin/env bash
# vim: set ft=jinja-shell ts=2 sw=2 et:

set -euo pipefail

cd -- {{ ccu_root | ansible.builtin.quote }}

ccu() {
  local newest_file

  newest_file="$(
    LC_ALL=C find {{ ccu_root | ansible.builtin.quote }}/backups \
                  -maxdepth 1 \
                  -type f \
                  -name '*.sbk' \
                  -printf '%T@\t%f\n' |
      LC_ALL=C sort --numeric-sort |
      tail --lines=1 |
      cut --fields=2-
  )"

  if [[ -z "$newest_file" ]]; then
    printf 'No .sbk backup found\n' >&2
    return 1
  fi

  docker compose up \
                 --wait \
                 ccu

  docker compose \
         exec \
         ccu \
         /bin/restoreBackup.sh "/backups/$newest_file"
}

ccu
