services:
  db:
    image: postgres:18.4-alpine
    environment:
      POSTGRES_USER: vaultwarden
      POSTGRES_PASSWORD: vaultwarden
      POSTGRES_DB: vaultwarden
      TZ: Europe/Berlin

      # For psql invocations.
      PGUSER: vaultwarden
      PGPASSWORD: vaultwarden
      PGDATABASE: vaultwarden
    volumes:
      - ./db:/var/lib/postgresql
    healthcheck:
      test:
        - CMD
        - psql
        - --command=select 1
      interval: 5s
      timeout: 5s
      retries: 3

  app:
    image: vaultwarden/server:1.37.0-alpine
    restart: unless-stopped
    user: "{{ vaultwarden_uid_gid | ansible.builtin.mandatory }}:{{ vaultwarden_uid_gid }}"
    ports:
      - 4004:80
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./app:/data/
    env_file:
      - ./.env.vaultwarden
    environment:
      RUST_BACKTRACE: 1
    depends_on:
      db:
        condition: service_healthy
