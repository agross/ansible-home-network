state: /var/lib/dyndns-updater/state.json
refresh: 600h # 25 days; Go duration syntax (h, m, s), not "25d"
timeout: 30s # per provider request and sendmail invocation
sendmail: /usr/sbin/sendmail
recipient: root
sender_name: dyndns-updater on {{ inventory_hostname }}
profiles:
  deSEC:
    provider: desec
    sources:
      - if: {{ gateway_interface | ansible.builtin.mandatory }}
      - web: ipify
      - web: ifconfig.me
    target: {{ network.domain | ansible.builtin.mandatory }}
    token: {{ gateway_dyndns_password | ansible.builtin.mandatory }}

  Tunnel Broker:
    provider: tunnelbroker
    sources:
      - if: {{ gateway_interface | ansible.builtin.mandatory }}
      - web: ipify
      - web: ifconfig.me
    target: {{ he_ipv6.tunnel_id | ansible.builtin.mandatory }}
    username: {{ he_ipv6.username | ansible.builtin.mandatory }}
    password: {{ he_ipv6.update_key | ansible.builtin.mandatory }}
