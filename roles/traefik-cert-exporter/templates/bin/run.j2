#!/usr/bin/env bash
# vim: set ft=jinja-shell ts=2 sw=2 et:

set -euo pipefail

root={{ traefik_cert_exporter_root | ansible.builtin.quote }}
export_dir="$root/export"
hooks_dir="$root/hooks"
acme={{ traefik_config_root_dir | ansible.builtin.quote }}/acme

mkdir --parents -- "$export_dir" "$hooks_dir"

printf -v now "@%(%s)T"

find "$acme" -type f -name '*.json' -exec \
  "$root/bin/export-certs" \
  {} \
  "$export_dir" \
  \;

mapfile -d '' -t certs < <(
  find "$export_dir/certs" -type f -name '*.crt' -newermt "$now" -print0
)
mapfile -d '' -t hooks < <(find "$hooks_dir" -type f -executable -print0)

failed_hooks=0

for cert in "${certs[@]}"; do
  domain="${cert%.crt}"
  domain="${domain##*/}"

  key="$export_dir/private/$domain.key"
  this_cert_failed=0

  printf 'DOMAIN=%s\nCERT=%s\nCERT_KEY=%s\n' "$domain" "$cert" "$key"

  for hook in "${hooks[@]}"; do
    printf 'Executing hook: %s\n' "$hook"

    if ! DOMAIN=$domain CERT=$cert CERT_KEY=$key "$hook"; then
      printf 'Hook failed; certificate will be exported again\n'
      this_cert_failed=1
      (( ++failed_hooks ))
    fi
  done

  if (( this_cert_failed )); then
    rm --force -- "$cert" "$key"
  fi
done

if (( failed_hooks > 0 )); then
  printf '%s hooks failed' "$failed_hooks"
  exit 1
fi
