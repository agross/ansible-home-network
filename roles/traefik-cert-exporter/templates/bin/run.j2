#!/usr/bin/env bash
# vim: set ft=jinja-shell ts=2 sw=2 et:

set -euo pipefail

root={{ traefik_cert_exporter_root | ansible.builtin.quote }}
export_dir="$root/export"
hooks_dir="$root/hooks"
acme={{ traefik_config_root_dir | ansible.builtin.quote }}/acme

mkdir --parents -- "$export_dir/certs" "$export_dir/private" "$hooks_dir"

printf -v now "@%(%s)T"

# Skip unused ACME stores and attempt every export before reporting failures.
mapfile -d '' -t acmefiles < <(
  find "$acme" -type f -name '*.json' -size +0c -print0
)

failed_exports=0

for acmefile in "${acmefiles[@]}"; do
  if ! "$root/bin/export-certs" "$acmefile" "$export_dir"; then
    printf 'Certificate export failed: %s\n' "$acmefile" >&2
    (( ++failed_exports ))
  fi
done

mapfile -d '' -t certs < <(
  find "$export_dir/certs" -type f -name '*.fullchain.crt' \
    -newermt "$now" -print0
)
mapfile -d '' -t hooks < <(find "$hooks_dir" -type f -executable -print0)

failed_hooks=0

for cert in "${certs[@]}"; do
  domain="${cert%.fullchain.crt}"
  domain="${domain##*/}"

  key="$export_dir/private/$domain.key"
  intermediate="${cert%.fullchain.crt}.intermediate.crt"
  leaf="${cert%.fullchain.crt}.leaf.crt"
  this_cert_failed=0

  printf 'DOMAIN=%s\nCERT_FULLCHAIN=%s\nCERT_LEAF=%s\nCERT_INTERMEDIATE=%s\nCERT_KEY=%s\n' \
    "$domain" "$cert" "$leaf" "$intermediate" "$key"

  for hook in "${hooks[@]}"; do
    printf 'Executing hook: %s\n' "$hook"

    if ! DOMAIN=$domain CERT_FULLCHAIN=$cert CERT_LEAF=$leaf CERT_INTERMEDIATE=$intermediate CERT_KEY=$key "$hook"; then
      printf 'Hook failed; certificate will be exported again\n'
      this_cert_failed=1
      (( ++failed_hooks ))
    fi
  done

  if (( this_cert_failed )); then
    rm --force -- "$cert" "$intermediate" "$leaf" "$key"
  fi
done

if (( failed_hooks > 0 )); then
   >&2 printf '%s hooks failed\n' "$failed_hooks"
fi

if (( failed_exports )); then
   >&2 printf '%s exports failed\n' "$failed_exports"
fi

if (( failed_exports > 0 || failed_hooks > 0 )); then
  exit 1
fi
